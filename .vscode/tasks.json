{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Client",
            "type": "shell",
            "command": "flutter run -d chrome",
            "options": {
                "cwd": "${workspaceFolder}/client"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Server",
            "type": "shell",
            "command": "dart run bin/server.dart",
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start All",
            "dependsOn": [
                "Start Client",
                "Start Server"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}