{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Client",
            "type": "shell",
            "command": "flutter run -d chrome --web-port 8081",
            "options": {
                "cwd": "${workspaceFolder}/client"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Server",
            "type": "shell",
            "command": "dart run bin/server.dart --port=8082",
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Reverse Proxy",
            "type": "shell",
            "command": "dart run",
            "options": {
                "cwd": "${workspaceFolder}/reverse_proxy"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start All",
            "dependsOn": [
                "Start Client",
                "Start Server",
                "Start Reverse Proxy"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}